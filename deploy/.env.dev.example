# =============================================================================
# 开发环境变量（复制为 .env.dev 后使用，禁止提交到 Git）
# 启动：docker compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml up -d
# =============================================================================
COMPOSE_PROJECT_NAME=pmp-dev
APP_ENV=dev
TZ=Asia/Shanghai

# ---------- 接入层 ----------
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
SERVER_NAME=_
CLIENT_MAX_BODY_SIZE=50m
BACKEND_UPSTREAM=backend:8080

# ---------- 本机调试端口 ----------
BACKEND_DEBUG_PORT=8081
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=29092
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- 镜像 ----------
NGINX_IMAGE=nginx:1.27.3-alpine
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21
JRE_IMAGE=eclipse-temurin:21-jre-alpine
FRONTEND_IMAGE=pmp/frontend:dev
BACKEND_IMAGE=pmp/backend:dev
POSTGRES_IMAGE=postgres:15.8-alpine
REDIS_IMAGE=redis:7.4.1-alpine
KAFKA_IMAGE=confluentinc/cp-kafka:7.7.1
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MC_IMAGE=minio/mc:RELEASE.2024-11-21T17-21-54Z
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
LOKI_IMAGE=grafana/loki:3.3.2
PROMTAIL_IMAGE=grafana/promtail:3.3.2
GRAFANA_IMAGE=grafana/grafana:11.4.0

# ---------- 中间件（仅开发环境允许弱口令） ----------
POSTGRES_DB=pmp
POSTGRES_USER=pmp
POSTGRES_PASSWORD=dev_pg_password
REDIS_PASSWORD=dev_redis_password
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
MINIO_ROOT_USER=pmpadmin
MINIO_ROOT_PASSWORD=dev_minio_password
MINIO_BUCKET=pmp-files
MINIO_BROWSER_REDIRECT_URL=

# ---------- 应用 ----------
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC -Djava.io.tmpdir=/tmp"

# ---------- 可观测 ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev_grafana_password
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://127.0.0.1:3000

# ---------- 备份 ----------
BACKUP_RETENTION_DAYS=7
