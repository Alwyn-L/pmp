﻿# =============================================================================
# PMP 生产环境变量模板
# 使用：cp .env.example .env && 逐项替换 CHANGE_ME 后执行 docker compose config 校验
# 安全：.env 禁止提交到 Git；生产建议由 Vault/密钥管理系统注入后生成
# =============================================================================

# ---------- 项目 ----------
COMPOSE_PROJECT_NAME=pmp
APP_ENV=prod
TZ=Asia/Shanghai

# ---------- 接入层 ----------
HTTP_BIND=0.0.0.0
HTTP_PORT=80
SERVER_NAME=_
CLIENT_MAX_BODY_SIZE=20m
BACKEND_UPSTREAM=backend:8080

# ---------- 镜像版本（禁止 latest） ----------
NODE_IMAGE=node:22-alpine
NPM_REGISTRY=https://registry.npmjs.org
NGINX_IMAGE=nginx:1.27.3-alpine
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21
# Maven 镜像源：默认阿里云；设为 central 使用官方中央仓库
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
JRE_IMAGE=eclipse-temurin:21-jre-alpine
FRONTEND_IMAGE=pmp/frontend:1.0.0
BACKEND_IMAGE=pmp/backend:1.0.0
POSTGRES_IMAGE=postgres:15.8-alpine
REDIS_IMAGE=redis:7.4.1-alpine
KAFKA_IMAGE=confluentinc/cp-kafka:7.7.1
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MC_IMAGE=minio/mc:RELEASE.2024-11-21T17-21-54Z
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
LOKI_IMAGE=grafana/loki:3.3.2
PROMTAIL_IMAGE=grafana/promtail:3.3.2
GRAFANA_IMAGE=grafana/grafana:11.4.0

# ---------- PostgreSQL ----------
POSTGRES_DB=pmp
POSTGRES_USER=pmp
POSTGRES_PASSWORD=CHANGE_ME_pg_strong_password

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# ---------- Kafka ----------
# 必须是 22 位 base64 URL-safe 的集群 ID，可用 kafka-storage.sh random-uuid 生成
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ---------- MinIO ----------
MINIO_ROOT_USER=pmpadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password
MINIO_BUCKET=pmp-files
MINIO_BROWSER_REDIRECT_URL=

# ---------- 应用 ----------
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError -XX:+UseG1GC"

# ---------- 认证（JWT 双令牌 + Redis 会话） ----------
# 密钥必须为 >= 32 字符随机串，可用 openssl rand -base64 48 生成
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800
AUTH_SINGLE_SESSION=true
AUTH_FAIL_LIMIT=5
AUTH_FAIL_WINDOW=900
AUTH_LOCK_SECONDS=1800
# 首次启动创建 admin 账号时使用，部署后请立即在系统内修改
AUTH_ADMIN_PASSWORD=CHANGE_ME_admin_initial_password

# ---------- 可观测 ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_strong_password
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://127.0.0.1:3000

# ---------- 备份 ----------
BACKUP_RETENTION_DAYS=30
