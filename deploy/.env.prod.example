# =============================================================================
# 生产环境变量（复制为 .env 后使用，禁止提交到 Git）
# 安全要求：
#   1. 所有 CHANGE_ME 必须替换为 16 位以上强随机密码，建议由 Vault/KMS 注入；
#   2. 文件权限 600，属主为部署账号（chmod 600 .env && chown deploy:deploy .env）；
#   3. 生产禁止使用 dev/test 的弱口令与 127.0.0.1 绑定地址以外的改动需评审。
# =============================================================================
COMPOSE_PROJECT_NAME=pmp
APP_ENV=prod
TZ=Asia/Shanghai

# ---------- 接入层 ----------
HTTP_BIND=0.0.0.0
HTTP_PORT=80
SERVER_NAME=pmp.example.com
CLIENT_MAX_BODY_SIZE=20m
BACKEND_UPSTREAM=backend:8080

# ---------- 镜像版本（发布时由流水线改写 tag，禁止 latest） ----------
NGINX_IMAGE=nginx:1.27.3-alpine
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21
JRE_IMAGE=eclipse-temurin:21-jre-alpine
FRONTEND_IMAGE=pmp/frontend:1.0.0
BACKEND_IMAGE=pmp/backend:1.0.0
POSTGRES_IMAGE=postgres:15.8-alpine
REDIS_IMAGE=redis:7.4.1-alpine
KAFKA_IMAGE=confluentinc/cp-kafka:7.7.1
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MC_IMAGE=minio/mc:RELEASE.2024-11-21T17-21-54Z
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
LOKI_IMAGE=grafana/loki:3.3.2
PROMTAIL_IMAGE=grafana/promtail:3.3.2
GRAFANA_IMAGE=grafana/grafana:11.4.0

# ---------- 中间件（一律由密钥系统注入，禁止提交真实值） ----------
POSTGRES_DB=pmp
POSTGRES_USER=pmp
POSTGRES_PASSWORD=CHANGE_ME_pg_strong_password
REDIS_PASSWORD=CHANGE_ME_redis_strong_password
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
MINIO_ROOT_USER=pmpadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password
MINIO_BUCKET=pmp-files
MINIO_BROWSER_REDIRECT_URL=

# ---------- 应用 ----------
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError -XX:+UseG1GC -Djava.io.tmpdir=/tmp"

# ---------- 可观测（Grafana 仅绑定 127.0.0.1，通过堡垒机/内网访问） ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_strong_password
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=https://pmp.example.com/grafana

# ---------- 备份 ----------
BACKUP_RETENTION_DAYS=30
