# =============================================================================
# PMP 站点配置模板（挂载到 /etc/nginx/templates，容器启动时渲染到
# /etc/nginx/conf.d/default.conf）
# 可用环境变量：
#   ${SERVER_NAME}            对外域名，默认 _
#   ${CLIENT_MAX_BODY_SIZE}   上传大小限制，默认 20m
#   ${BACKEND_UPSTREAM}       后端上游地址，默认 backend:8080
# 注意：模板中的 nginx 内置变量（$uri/$host 等）不会被 envsubst 替换，
#       因为渲染脚本只替换容器内真实存在的环境变量。
# =============================================================================
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 3s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name ${SERVER_NAME};

    root  /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    client_body_timeout   30s;
    client_header_timeout 15s;

    # ---------- 安全响应头（全局继承，location 内不要再写 add_header） ----------
    add_header X-Content-Type-Options   "nosniff" always;
    add_header X-Frame-Options          "SAMEORIGIN" always;
    add_header Referrer-Policy          "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy       "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy  "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    # ---------- 健康检查（不写日志，避免探针刷屏） ----------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    # ---------- 静态资源缓存 ----------
    location /assets/ {
        expires 1h;
        try_files $uri =404;
    }

    location = /index.html {
        expires -1;   # 入口文件不缓存，保证发版即时生效
    }

    # ---------- 后端接口反向代理 ----------
    location /api/ {
        set $backend "http://${BACKEND_UPSTREAM}";

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header X-Request-Id      $request_id;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_connect_timeout 3s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;

        proxy_pass $backend;
    }

    # ---------- 管理端点不对外暴露（仅容器内网/监控网络可达） ----------
    location /actuator/ {
        return 404;
    }

    # ---------- 前端路由回退（hash 路由同样适用，兜底直接用 index.html） ----------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---------- 拒绝隐藏文件 ----------
    location ~ /\.(?!well-known) {
        deny all;
    }
}
