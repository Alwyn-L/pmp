# =============================================================================
# 测试（预发）环境变量（复制为 .env.test 后使用，禁止提交到 Git）
# 启动：docker compose --env-file .env.test -f docker-compose.yml -f docker-compose.test.yml up -d
# =============================================================================
COMPOSE_PROJECT_NAME=pmp-test
APP_ENV=test
TZ=Asia/Shanghai

# ---------- 接入层 ----------
HTTP_BIND=0.0.0.0
HTTP_PORT=8088
SERVER_NAME=test.pmp.internal
CLIENT_MAX_BODY_SIZE=50m
BACKEND_UPSTREAM=backend:8080

# ---------- 镜像 ----------
NGINX_IMAGE=nginx:1.27.3-alpine
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21
JRE_IMAGE=eclipse-temurin:21-jre-alpine
FRONTEND_IMAGE=pmp/frontend:test
BACKEND_IMAGE=pmp/backend:test
POSTGRES_IMAGE=postgres:15.8-alpine
REDIS_IMAGE=redis:7.4.1-alpine
KAFKA_IMAGE=confluentinc/cp-kafka:7.7.1
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MC_IMAGE=minio/mc:RELEASE.2024-11-21T17-21-54Z
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
LOKI_IMAGE=grafana/loki:3.3.2
PROMTAIL_IMAGE=grafana/promtail:3.3.2
GRAFANA_IMAGE=grafana/grafana:11.4.0

# ---------- 中间件密码：由测试环境密钥库注入，禁止提交真实值 ----------
POSTGRES_DB=pmp
POSTGRES_USER=pmp
POSTGRES_PASSWORD=CHANGE_ME_test_pg_password
REDIS_PASSWORD=CHANGE_ME_test_redis_password
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
MINIO_ROOT_USER=pmpadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_test_minio_password
MINIO_BUCKET=pmp-files
MINIO_BROWSER_REDIRECT_URL=

# ---------- 应用 ----------
SPRING_PROFILES_ACTIVE=test
JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError -XX:+UseG1GC -Djava.io.tmpdir=/tmp"

# ---------- 可观测 ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_test_grafana_password
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://127.0.0.1:3001

# ---------- 备份 ----------
BACKUP_RETENTION_DAYS=14
